server {
    listen 80;
    server_name shoditsa.ru www.shoditsa.ru;
    return 301 https://shoditsa.ru$request_uri;
}

server {
    listen 443 ssl http2;
    server_name shoditsa.ru www.shoditsa.ru;

    if ($host = www.shoditsa.ru) {
        return 301 https://shoditsa.ru$request_uri;
    }

    root /opt/shoditsa/current/web;
    index index.html;
    client_max_body_size 25m;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /media/ {
        alias /opt/shoditsa/shared/media/;
        try_files $uri =404;
        autoindex off;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # The server build must never expose legacy answer-bearing datasets.
    location ^~ /data/ {
        return 404;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /city-content/ {
        return 404;
        add_header Cache-Control "no-store" always;
    }

    location ~* ^/assets/.*\.[a-f0-9]{8,}\.(js|css|woff2|png|webp)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ~* "^/(images/animals/silhouettes|audio/animals)/[a-f0-9]{24}\.(webp|ogg)$" {
        try_files $uri =404;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    # Search engines receive route-specific HTML (metadata, JSON-LD and useful
    # text) at the canonical browser-history URL. The /seo files themselves are
    # implementation details and cannot be opened as duplicate public pages.
    location ~ ^/games/(movie|series|anime|game|game-comments|city|music|diagnosis|animal|book|connections|danetki)$ {
        try_files /seo$uri.html =404;
        add_header Cache-Control "no-cache" always;
    }

    location ~ ^/(partners|specials|club)$ {
        try_files /seo$uri.html =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /games/together {
        try_files /index.html =404;
        add_header X-Robots-Tag "noindex, follow, noarchive" always;
        add_header Cache-Control "no-cache" always;
    }

    location /games/ {
        return 404;
    }

    location ^~ /seo/ {
        internal;
    }

    # Personal, transactional and in-progress routes are useful to players but
    # must not create thin or private documents in the search index. Keep this
    # allow-list explicit so a made-up path cannot inherit the SPA's HTTP 200.
    # BEGIN SHODITSA_EXPLICIT_SPA_ROUTES
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-cache" always;
    }

    location ~ ^/(archive|profile|login|register)$ {
        try_files /index.html =404;
        add_header X-Robots-Tag "noindex, follow, noarchive" always;
        add_header Cache-Control "no-cache" always;
    }

    location ~ ^/(play/(movie|series|anime|game|music|diagnosis|city|animal|book|connections)|sessions/[^/]+|review/music|purchase/return|danetki/join/[^/]+|specials/[^/]+)$ {
        try_files /index.html =404;
        add_header X-Robots-Tag "noindex, follow, noarchive" always;
        add_header Cache-Control "no-cache" always;
    }

    location ~ ^/legal/(terms|tariffs|privacy|personal-data-consent|refunds|contacts)$ {
        try_files /seo$uri.html =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /create-a-game {
        try_files /index.html =404;
        add_header X-Robots-Tag "noindex, follow, noarchive" always;
        add_header Cache-Control "no-cache" always;
    }

    location = /ui-kit {
        try_files /index.html =404;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Cache-Control "no-cache" always;
    }
    # END SHODITSA_EXPLICIT_SPA_ROUTES

    location = /admin {
        try_files /index.html =404;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Cache-Control "no-cache" always;
    }

    location ^~ /admin/ {
        try_files /index.html =404;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri =404;
    }
}
